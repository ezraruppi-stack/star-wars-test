lock type=\"logic_compare\"><field name=\"OP\">EQ</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"lists_index_get\"><value name=\"LIST\"><block type=\"argument_reporter_array\"><field name=\"VALUE\">noten</field></block></value><value name=\"INDEX\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"XbWQ=uq},O7(CzzK+gd+\">i</field></block></value></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value></block></value><statement name=\"DO0\"><block type=\"device_rest\"><value name=\"duration\"><shadow type=\"device_beat\"><field name=\"fraction\">BeatFraction.Whole</field></shadow><block type=\"math_number\"><field name=\"NUM\">300</field></block></value></block></statement><statement name=\"ELSE\"><block type=\"device_play_note\"><value name=\"note\"><shadow type=\"device_note\"><field name=\"name\">262</field></shadow><block type=\"lists_index_get\"><value name=\"LIST\"><block type=\"argument_reporter_array\"><field name=\"VALUE\">noten</field></block></value><value name=\"INDEX\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"XbWQ=uq},O7(CzzK+gd+\">i</field></block></value></block></value><value name=\"duration\"><shadow type=\"device_beat\"><field name=\"fraction\">BeatFraction.Whole</field></shadow><block type=\"math_number\"><field name=\"NUM\">300</field></block></value></block></statement><next><block type=\"variables_change\"><field name=\"VAR\" id=\"=/lVR`gm%JYz0!eXXvyn\">schritt</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></next></block></next></block></next></block></statement></block></statement><next><block type=\"motor_motorStop\"><field name=\"motors\">maqueen.Motors.All</field><next><block type=\"function_call\"><mutation name=\"scheinwerferAus\" functionid=\"c.0}D=xH5|pZdifaCQ,P\"></mutation><next><block type=\"device_clear_display\"><next><block type=\"variables_set\"><field name=\"VAR\" id=\"WU[h*iy$1+_~M(M/OSRt\">spielt</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"logic_boolean\"><field name=\"BOOL\">FALSE</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"\nlet freq = 0\nlet dauer = 0\nlet hoehe = 1\n\nlet imperium: Image = null\nlet vader: Image = null\nlet schwert: Image = null\nlet block: Image = null\nlet spitzhacke: Image = null\nlet creeper: Image = null\n\n// ==========================================\n// LED-BILDER\n// ==========================================\n\nimperium = images.createImage(`\n. # . # .\n# . # . #\n. # # # .\n# . # . #\n. # . # .\n`)\n\nvader = images.createImage(`\n. # # # .\n# # # # #\n# . # . #\n# # # # #\n# . . . #\n`)\n\nschwert = images.createImage(`\n. . . . #\n. . . # .\n. . # . .\n# # . . .\n# . . . .\n`)\n\nblock = images.createImage(`\n# # # # #\n# . . . #\n# . # . #\n# . . . #\n# # # # #\n`)\n\nspitzhacke = images.createImage(`\n. # # # .\n# . # . #\n. . # . .\n. . # . .\n. . # . .\n`)\n\ncreeper = images.createImage(`\n# # . # #\n# # . # #\n. . # . .\n. # # # .\n. # . # .\n`)\n\n// ==========================================\n// BEWEGUNG UND LICHTER\n// ==========================================\n\nfunction bewegeMaqueen(schritt: number, modus: string) {\n\n    // Hindernis erkennen\n    if (maqueen.Ultrasonic() < 15) {\n        maqueen.motorStop(maqueen.Motors.All)\n        return\n    }\n\n    // Scheinwerfer blinken\n    if (schritt % 2 == 0) {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n    } else {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n    }\n\n    if (modus == \"imperium\") {\n        maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CW, 80)\n\n    } else if (modus == \"equalizer\") {\n\n        if (schritt % 4 < 2) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 70)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 70)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, 70)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 70)\n        }\n\n    } else if (modus == \"vader\") {\n\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n        maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CCW, 80)\n\n    } else if (modus == \"schwert\") {\n\n        maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 100)\n        maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 100)\n\n    } else if (modus == \"block\") {\n\n        if (schritt % 2 == 0) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 75)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 35)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 35)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 75)\n        }\n\n    } else if (modus == \"spitzhacke\") {\n\n        if (schritt % 2 == 0) {\n            maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CW, 65)\n        } else {\n            maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CCW, 65)\n        }\n\n    } else if (modus == \"creeper\") {\n\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n\n        maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 70)\n        maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 70)\n\n    } else if (modus == \"headlights\") {\n\n        // Elektronische Dance-Bewegung\n        if (schritt % 4 < 2) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 75)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 45)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 45)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 75)\n        }\n    }\n}\n\n// ==========================================\n// EQUALIZER-DISPLAY\n// ==========================================\n\nfunction zeigeBalken(frequenz: number) {\n\n    basic.clearScreen()\n    hoehe = 1\n\n    if (frequenz >= 700) {\n        hoehe = 5\n    } else if (frequenz >= 550) {\n        hoehe = 4\n    } else if (frequenz >= 450) {\n        hoehe = 3\n    } else if (frequenz >= 350) {\n        hoehe = 2\n    }\n\n    for (let x = 0; x <= 4; x++) {\n        for (let y = 0; y < hoehe; y++) {\n            led.plot(x, 4 - y)\n        }\n    }\n}\n\n// ==========================================\n// MUSIK ABSPIELEN\n// ==========================================\n\nfunction spieleTeil(noten: number[][], modus: string) {\n\n    for (let i = 0; i < noten.length; i++) {\n\n        freq = noten[i][0]\n        dauer = noten[i][1]\n\n        if (maqueen.Ultrasonic() < 15) {\n            maqueen.motorStop(maqueen.Motors.All)\n        }\n\n        if (freq == 0) {\n\n            basic.clearScreen()\n            maqueen.motorStop(maqueen.Motors.All)\n            music.rest(dauer)\n\n        } else {\n\n            bewegeMaqueen(i, modus)\n\n            if (modus == \"imperium\") {\n\n                if (i % 2 == 0) {\n                    imperium.showImage(0)\n                } else {\n                    basic.clearScreen()\n                }\n\n            } else if (modus == \"vader\") {\n\n                if (i % 2 == 0) {\n                    vader.showImage(0)\n                } else {\n                    imperium.showImage(0)\n                }\n\n            } else if (modus == \"schwert\") {\n\n                if (i % 2 == 0) {\n                    schwert.showImage(0)\n                } else {\n                    vader.showImage(0)\n                }\n\n            } else if (modus == \"block\") {\n\n                if (i % 2 == 0) {\n                    block.showImage(0)\n                } else {\n                    basic.clearScreen()\n                }\n\n            } else if (modus == \"spitzhacke\") {\n\n                if (i % 2 == 0) {\n                    spitzhacke.showImage(0)\n                } else {\n                    block.showImage(0)\n                }\n\n            } else if (modus == \"creeper\") {\n\n                if (i % 2 == 0) {\n                    creeper.showImage(0)\n                } else {\n                    spitzhacke.showImage(0)\n                }\n\n            } else {\n\n                zeigeBalken(freq)\n            }\n\n            music.playTone(freq, dauer)\n        }\n    }\n}\n\n// ==========================================\n// KNOPF A: STAR WARS\n// ==========================================\n\ninput.onButtonPressed(Button.A, function () {\n\n    music.setTempo(105)\n    basic.showString(\"STAR WARS\")\n\n    let h = music.beat(BeatFraction.Half)\n    let q = music.beat(BeatFraction.Quarter)\n    let e = music.beat(BeatFraction.Eighth)\n    let w = music.beat(BeatFraction.Whole)\n\n    let teil1: number[][] = [\n        [392, h], [440, h], [494, q], [523, q],\n        [494, e], [440, e], [392, h],\n        [330, q], [392, q], [440, h],\n        [494, q], [523, q], [587, w]\n    ]\n\n    let teil2: number[][] = [\n        [587, q], [659, q], [698, e], [659, e],\n        [587, q], [523, q], [494, h],\n        [440, q], [494, q], [523, q],\n        [587, q], [659, w]\n    ]\n\n    let finale: number[][] = [\n        [392, h], [440, h], [494, q], [523, q],\n        [587, h], [523, q], [494, q],\n        [440, h], [392, w]\n    ]\n\n    spieleTeil(teil1, \"imperium\")\n    spieleTeil(teil2, \"equalizer\")\n    spieleTeil(teil2, \"vader\")\n    spieleTeil(finale, \"schwert\")\n\n    maqueen.motorStop(maqueen.Motors.All)\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n\n    vader.showImage(0)\n})\n\n// ==========================================\n// KNOPF B: MINECRAFT\n// ==========================================\n\ninput.onButtonPressed(Button.B, function () {\n\n    music.setTempo(84)\n    basic.showString(\"MINECRAFT\")\n\n    let q = music.beat(BeatFraction.Quarter)\n    let e = music.beat(BeatFraction.Eighth)\n    let h = music.beat(BeatFraction.Half)\n    let w = music.beat(BeatFraction.Whole)\n\n    let teil1: number[][] = [\n        [330, e], [392, e], [494, e], [392, e],\n        [330, e], [494, e], [523, e], [494, e],\n        [392, q], [330, e], [392, e], [494, q]\n    ]\n\n    let teil2: number[][] = [\n        [370, q], [330, e], [370, e], [392, q],\n        [494, q], [659, h], [587, q],\n        [494, q], [370, q], [330, w]\n    ]\n\n    let teil3: number[][] = [\n        [494, q], [392, e], [370, e], [392, q],\n        [494, q], [659, h], [587, q],\n        [494, q], [370, q], [330, q], [294, h]\n    ]\n\n    let finale: number[][] = [\n        [330, e], [494, e], [330, e], [494, e],\n        [392, e], [523, e], [494, q],\n        [392, q], [330, w]\n    ]\n\n    spieleTeil(teil1, \"block\")\n    spieleTeil(teil2, \"equalizer\")\n    spieleTeil(teil3, \"spitzhacke\")\n    spieleTeil(finale, \"creeper\")\n\n    maqueen.motorStop(maqueen.Motors.All)\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n\n    creeper.showImage(0)\n})\n\n// ==========================================\n// KNOPF A+B: HEADLIGHTS\n// ==========================================\n\ninput.onButtonPressed(Button.AB, function () {\n\n    music.setTempo(110)\n    basic.showString(\"HEADLIGHTS\")\n\n    let q = music.beat(BeatFraction.Quarter)\n    let e = music.beat(BeatFraction.Eighth)\n    let h = music.beat(BeatFraction.Half)\n\n    let headlightsMelodie: number[][] = [\n\n        [440, e], [494, e], [523, q], [659, q],\n        [587, e], [523, e], [494, q], [440, q],\n\n        [523, e], [587, e], [659, q], [784, q],\n        [659, e], [587, e], [523, h],\n\n        [440, e], [523, e], [587, q], [659, q],\n        [784, e], [659, e], [587, q], [523, h],\n\n        [659, e], [784, e], [880, q], [784, q],\n        [659, e], [587, e], [523, h]\n    ]\n\n    spieleTeil(headlightsMelodie, \"headlights\")\n\n    maqueen.motorStop(maqueen.Motors.All)\n\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n\n    basic.showString(\"A/B\")\n})\n\n// ==========================================\n// START\n// ==========================================\n\nbasic.showString(\"A/B\")\n\n// ==========================================\n// ULTRASCHALL-SENSOR\n// ==========================================\n\nbasic.forever(function () {\n\n    if (maqueen.Ultrasonic() < 15) {\n\n        maqueen.motorStop(maqueen.Motors.All)\n        basic.pause(100)\n    }\n\n    basic.pause(50)\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"star wars test\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"maqueen\": \"github:dfrobot/pxt-maqueen#v1.7.17\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794648562992,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"$Q7LZf}yCjQB(kQ0Da0!\">i</variable><variable id=\"pOe7~;KQCSLPV+Mc?x=S\">freq</variable><variable id=\"z(C0_!!hPDdLF2~NG[;x\">dauer<