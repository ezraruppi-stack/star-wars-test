89081779,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"function fahren (schritt: number, typ: number) {\n    if (amWenden) {\n        return\n    }\n    scheinwerferAn(schritt)\n    if (typ == 1) {\n        // Star-Wars-Marsch\n        maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CW, 80)\n    } else if (typ == 2) {\n        // Minecraft-Slalom\n        if (schritt % 2 == 0) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 75)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 35)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 35)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 75)\n        }\n    } else {\n        // Headlights-Tanz\n        if (schritt % 4 < 2) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 110)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 110)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, 110)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 110)\n        }\n    }\n}\nfunction allesStoppen () {\n    maqueen.motorStop(maqueen.Motors.All)\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n    laeuft = false\n    modusAktiv = false\n}\nfunction spieleTeil (noten: any[], typ: number, bild: Image) {\n    for (let i = 0; i <= noten.length - 1; i++) {\n        if (!(laeuft)) {\n            return\n        }\n        fahren(i, typ)\n        if (!(amWenden)) {\n            if (typ == 3) {\n                basic.clearScreen()\n                for (let x = 0; x <= 4; x++) {\n                    led.plot(x, i % 5)\n                }\n            } else {\n                bild.showImage(0)\n            }\n        }\n        if (noten[i][0] == 0) {\n            music.rest(noten[i][1])\n        } else {\n            music.playTone(noten[i][0], noten[i][1])\n        }\n    }\n}\n// STAR WARS - Taste A\ninput.onButtonPressed(Button.A, function () {\n    if (laeuft) {\n        return\n    }\n    laeuft = true\n    modusAktiv = true\n    music.setTempo(105)\n    basic.showString(\"STAR WARS\")\n    // Tonfolge als Platzhalter: hier deine eigenen Notendaten einsetzen\n    imperialMarch = [\n    [392, 500],\n    [392, 500],\n    [392, 500],\n    [311, 350],\n    [466, 150],\n    [392, 500],\n    [311, 350],\n    [466, 150],\n    [392, 900]\n    ]\n    spieleTeil(imperialMarch, 1, imperium)\n    if (laeuft) {\n        vader.showImage(0)\n    }\n    allesStoppen()\n})\nfunction hindernisPruefen () {\n    if (laeuft && !(amWenden)) {\n        abstand = maqueen.Ultrasonic()\n        if (abstand > 0 && abstand < 15 && input.runningTime() - letzterWendeZeit > 1200) {\n            amWenden = true\n            letzterWendeZeit = input.runningTime()\n            maqueen.motorStop(maqueen.Motors.All)\n            basic.pause(150)\n            // Auf der Stelle umdrehen\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 120)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 120)\n            basic.pause(650)\n            maqueen.motorStop(maqueen.Motors.All)\n            basic.pause(150)\n            amWenden = false\n        }\n    }\n}\n// HEADLIGHTS - Taste A+B\ninput.onButtonPressed(Button.AB, function () {\n    if (laeuft) {\n        return\n    }\n    laeuft = true\n    modusAktiv = true\n    music.setTempo(124)\n    basic.showString(\"HEADLIGHTS\")\n    startZeit = input.runningTime()\n    // Party läuft 30 Sekunden\n    while (input.runningTime() - startZeit < 30000 && laeuft) {\n        fahren(schritt, 3)\n        if (schritt % 2 == 0) {\n            music.playTone(659, 180)\n        } else {\n            music.playTone(523, 180)\n        }\n        schritt += 1\n    }\n    allesStoppen()\n    basic.showString(\"ENDE\")\n})\n// MINECRAFT - Taste B\ninput.onButtonPressed(Button.B, function () {\n    if (laeuft) {\n        return\n    }\n    laeuft = true\n    modusAktiv = true\n    music.setTempo(84)\n    basic.showString(\"MINECRAFT\")\n    // Tonfolge als Platzhalter: hier deine eigenen Notendaten einsetzen\n    ariaMath = [\n    [330, 180],\n    [494, 180],\n    [330, 180],\n    [494, 180],\n    [392, 350],\n    [523, 350],\n    [494, 350],\n    [392, 600]\n    ]\n    spieleTeil(ariaMath, 2, block)\n    if (laeuft) {\n        spitzhacke.showImage(0)\n        basic.pause(200)\n        creeper.showImage(0)\n    }\n    allesStoppen()\n})\nfunction scheinwerferAn (schritt: number) {\n    if (schritt % 2 == 0) {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n    } else {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n    }\n}\nlet ariaMath: number[][] = []\nlet schritt = 0\nlet startZeit = 0\nlet letzterWendeZeit = 0\nlet abstand = 0\nlet imperialMarch: number[][] = []\nlet modusAktiv = false\nlet laeuft = false\nlet amWenden = false\nlet creeper: Image = null\nlet spitzhacke: Image = null\nlet block: Image = null\nlet vader: Image = null\nlet imperium: Image = null\nimperium = images.createImage(`\n    . # . # .\n    # . # . #\n    . # # # .\n    # . # . #\n    . # . # .\n    `)\nvader = images.createImage(`\n    . # # # .\n    # # # # #\n    # . # . #\n    # # # # #\n    # . . . #\n    `)\nlet schwert = images.createImage(`\n    . . . . #\n    . . . # .\n    . . # . .\n    # # . . .\n    # . . . .\n    `)\nblock = images.createImage(`\n    # # # # #\n    # . . . #\n    # . # . #\n    # . . . #\n    # # # # #\n    `)\nspitzhacke = images.createImage(`\n    . # # # .\n    # . # . #\n    . . # . .\n    . . # . .\n    . . # . .\n    `)\ncreeper = images.createImage(`\n    # # . # #\n    # # . # #\n    . . # . .\n    . # # # .\n    . # . # .\n    `)\n// Start-Hinweis\nbasic.showString(\"A/B/AB\")\n// Sensor läuft unabhängig von der Musik\nbasic.forever(function () {\n    hindernisPruefen()\n    basic.pause(60)\n})\n"]]}]}]},{"timestamp":1794594902149,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":5396,"diffs":[[1,""]]}]}]},{"timestamp":1794594903023,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1235,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"CXZ8pTr=R+SXpjcjH4Gu\">laeuft</variable><variable id=\"Vg(8ShTTv5]=0B@#9#}6\">modusAktiv</variable><variable id=\"%Wcea#H{9Nu;5=GDY8ED\">amWenden</variable><variable id=\"hB-kpRc/Rw^0OHX(N)%H\">abstand</variable><variable id=\"%!C$fdgrBcjs9d;8dj{2\">letzterWendeZeit</variable><variable id=\"h(AlAOMtlFC:DbQv:u9D\">i</variable><variable id=\"0c7o*-1#ztHs+N$KssaH\">x</variable><variable id=\"uJY#uihJ{fu#`jr+!UHB\">imperialMarch</variable><variable id=\"%UghyoZ}##Oe;~vOBy~k\">list</variable><variable id=\"`8%aKzCoXN}K*pp702QN\">image</variable><variable id=\",(:@jqGeN`}OQGo;DUmo\">imperium</variable><variable id=\"h1c1lNA*WY2c#c[:SyL2\">vader</variable><variable id=\"fR]I$|KalMQ]gY=$KFK[\">ariaMath</variable><variable id=\"+zKr?s[CEsbm{dASn{,T\">block</variable><variable id=\"YVA7J#Cj:qj_Q;|T(UG|\">spitzhacke</variable><variable id=\".)e6oziF8/HiA$pn=ANG\">creeper</variable><variable id=\"c6[R,].!AtToz([FjS5n\">startZeit</variable><variable id=\"Td72?SX[]_C~+u]wA6Uz\">schritt</variable><variable id=\"#O([E2~m*vh#(@~v6~}f\">schwert</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\",(:@jqGeN`}OQGo;DUmo\">imperium</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"device_build_image\"><field name=\"LEDS\">`\n"]]},{"start1":1494