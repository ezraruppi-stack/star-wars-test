{"entries":[{"timestamp":1794568875601,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":185,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":385,"diffs":[[1,""]]},{"start1":1,"length1":9685,"diffs":[[1,""]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":120,"length1":83,"diffs":[[1,"        \"microphone\": \"*\"\n"]]},{"start1":237,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]}]},{"timestamp":1794569503320,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":10069,"length1":3,"diffs":[[1,"``"]]}]}]},{"timestamp":1794569514407,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":182,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block><block type=\"device_forever\" x=\"225\" y=\"20\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":30,"diffs":[[1,"let abstand = 0\nlet finale: number[][] = []\nlet teil2b: number[][] = []\nlet teil2a: number[][] = []\nlet teil1: number[][] = []\nlet qd = 0\nlet w = 0\nlet s = 0\nlet e = 0\nlet q = 0\nlet h = 0\nlet hoehe = 0\nlet creeper: Image = null\nlet spitzhacke: Image = null\nlet block: Image = null\nlet schwert: Image = null\nlet vader: Image = null\nlet imperium: Image = null\nlet dauer = 0\nlet freq = 0\n\nfunction spieleTeil(noten: number[][], modus: string) {\n    for (let i = 0; i <= noten.length - 1; i++) {\n        freq = noten[i][0]\n        dauer = noten[i][1]\n\n        // Ultraschallsensor abfragen (in cm)\n        abstand = maqueen.Ultrasonic(PingUnit.Centimeters)\n\n        if (abstand > 0 && abstand < 15) {\n            // Hindernis unter 15 cm: Auf der Stelle umdrehen & Lied weiterspielen\n            maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n            maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 110)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 110)\n            basic.showIcon(IconNames.No)\n\n            if (freq == 0) {\n                music.rest(dauer)\n            } else {\n                music.playTone(freq, dauer)\n            }\n        } else if (freq == 0) {\n            basic.clearScreen()\n            maqueen.motorStop(maqueen.Motors.All)\n            music.rest(dauer)\n        } else {\n            bewegeMaqueen(i, modus)\n            if (modus == \"imperium\") {\n                if (i % 2 == 0) {\n                    imperium.showImage(0, 0)\n                } else {\n                    basic.clearScreen()\n                }\n            } else if (modus == \"vader\") {\n                if (i % 2 == 0) {\n                    vader.showImage(0, 0)\n                } else {\n                    imperium.showImage(0, 0)\n                }\n            } else if (modus == \"schwert\") {\n                if (i % 2 == 0) {\n                    schwert.showImage(0, 0)\n                } else {\n                    vader.showImage(0, 0)\n                }\n            } else if (modus == \"block\") {\n                if (i % 2 == 0) {\n                    block.showImage(0, 0)\n                } else {\n                    basic.clearScreen()\n                }\n            } else if (modus == \"spitzhacke\") {\n                if (i % 2 == 0) {\n                    spitzhacke.showImage(0, 0)\n                } else {\n                    block.showImage(0, 0)\n                }\n            } else if (modus == \"creeper\") {\n                if (i % 2 == 0) {\n                    creeper.showImage(0, 0)\n                } else {\n                    spitzhacke.showImage(0, 0)\n                }\n            } else {\n                zeigeBalken(freq)\n            }\n            music.playTone(freq, dauer)\n        }\n    }\n}\n\n// --- Gemeinsame Hilfsfunktionen ---\nfunction zeigeBalken(frequenz: number) {\n    basic.clearScreen()\n    hoehe = 1\n    if (frequenz >= 700) {\n        hoehe = 5\n    } else if (frequenz >= 550) {\n        hoehe = 4\n    } else if (frequenz >= 450) {\n        hoehe = 3\n    } else if (frequenz >= 350) {\n        hoehe = 2\n    }\n    for (let x = 0; x <= 4; x++) {\n        for (let y = 0; y <= hoehe - 1; y++) {\n            if ((x == 0 || x == 4) && y == hoehe - 1 && hoehe > 1) {\n                continue;\n            }\n            led.plot(x, 4 - y)\n        }\n    }\n}\n\nfunction bewegeMaqueen(schritt: number, modus: string) {\n    // Scheinwerfer abwechselnd blinken lassen\n    if (schritt % 2 == 0) {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n    } else {\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n    }\n    // Fahr-Choreografie passend zum Liedteil (Star Wars & Minecraft)\n    if (modus == \"imperium\") {\n        // Stolzer Vorwärts-Marsch\n        maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CW, 80)\n    } else if (modus == \"equalizer\") {\n        // Dramatische Drehung auf der Stelle (links / rechts)\n        if (schritt % 4 < 2) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 70)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 70)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, 70)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 70)\n        }\n    } else if (modus == \"vader\") {\n        // Rückwärts-Marsch mit beiden Scheinwerfern an\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n        maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CCW, 80)\n    } else if (modus == \"schwert\") {\n        // Finale Pirouette\n        maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 110)\n        maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 110)\n    } else if (modus == \"block\") {\n        // Sanfter Slalom im Arpeggio-Takt\n        if (schritt % 2 == 0) {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 75)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 35)\n        } else {\n            maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 35)\n            maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, 75)\n        }\n    } else if (modus == \"spitzhacke\") {\n        // Ruckartiges Vor- und Zurück-Hacken\n        if (schritt % 2 == 0) {\n            maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CW, 65)\n        } else {\n            maqueen.motorRun(maqueen.Motors.All, maqueen.Dir.CCW, 65)\n        }\n    } else if (modus == \"creeper\") {\n        // Ruhige Kreisbewegung mit beiden Scheinwerfern\n        maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n        maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n        maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, 70)\n        maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, 70)\n    }\n}\n\n// ==========================================\n// KNOPF A: STAR WARS - IMPERIAL MARCH\n// ==========================================\ninput.onButtonPressed(Button.A, function () {\n    music.setTempo(105)\n    basic.showString(\"STAR WARS\")\n    imperium = images.createImage(`\n        . # . # .\n        # . # . #\n        . # # # .\n        # . # . #\n        . # . # .\n        `)\n    vader = images.createImage(`\n        . # # # .\n        # # # # #\n        # . # . #\n        # # # # #\n        # . . . #\n        `)\n    schwert = images.createImage(`\n        . . . . #\n        . . . # .\n        . . # . .\n        # # . . .\n        # . . . .\n        `)\n    h = music.beat(BeatFraction.Half)\n    q = music.beat(BeatFraction.Quarter)\n    e = music.beat(BeatFraction.Eighth)\n    s = music.beat(BeatFraction.Sixteenth)\n    w = music.beat(BeatFraction.Whole)\n    qd = q + e\n    teil1 = [\n        [392, h], [392, h], [392, h], [311, qd], [466, e],\n        [392, h], [311, qd], [466, e], [392, w], [587, h],\n        [587, h], [587, h], [622, qd], [466, e], [370, h],\n        [311, qd], [466, e], [392, w]\n    ]\n    teil2a = [\n        [784, h], [392, qd], [392, e], [784, h], [740, qd],\n        [698, e], [659, s], [622, s], [659, e], [0, e],\n        [415, e], [554, h], [523, qd], [494, e], [466, s],\n        [440, s], [466, e], [0, e], [311, e], [370, h],\n        [311, qd], [370, e], [466, h], [392, qd], [466, e],\n        [587, w]\n    ]\n    teil2b = [\n        [784, h], [392, qd], [392, e], [784, h], [740, qd],\n        [698, e], [659, s], [622, s], [659, e], [0, e],\n        [415, e], [554, h], [523, qd], [494, e], [466, s],\n        [440, s], [466, e], [0, e], [311, e], [370, h],\n        [311, qd], [466, e], [392, h], [311, qd], [466, e],\n        [392, w]\n    ]\n    finale = [\n        [392, h], [392, h], [392, h], [311, qd], [466, e],\n        [392, h], [311, qd], [466, e], [392, w], [587, h],\n        [587, h], [587, h], [622, qd], [466, e], [370, h],\n        [311, qd], [466, e], [392, w], [392, q], [311, e],\n        [466, e], [392, q], [311, e], [466, e], [392, w + h]\n    ]\n    spieleTeil(teil1, \"imperium\")\n    spieleTeil(teil2a, \"equalizer\")\n    spieleTeil(teil2b, \"vader\")\n    spieleTeil(finale, \"schwert\")\n    maqueen.motorStop(maqueen.Motors.All)\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n    vader.showImage(0)\n"]]},{"start1":8449