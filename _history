":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":0,"diffs":[[1,"/**\n * =====================================\n * \n * MAQUEEN – MOTOREN\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * LICHTER – KORRIGIERTE VERSION\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * ULTRASCHALLSENSOR\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * FAHRBEWEGUNGEN MIT SENSOR\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * MUSIK\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * TASTE A – STAR WARS SHOW\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * TASTE B – MINECRAFT SHOW\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * TASTE A+B – HEADLIGHTS SHOW\n * \n * 30 SEKUNDEN CLUB-DANCE\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * SHOW STARTEN\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * TASTEN\n * \n * =====================================\n */\n/**\n * =====================================\n * \n * STARTBILDSCHIRM\n * \n * =====================================\n */\nfunction fahren (tempo: number, dauer: number) {\n    start = input.runningTime()\n    while (input.runningTime() - start < dauer && modus != 0) {\n        hindernisPruefen()\n        if (modus != 0) {\n            vorwaerts(tempo)\n            basic.pause(50)\n        }\n    }\n    motorenStoppen()\n}\nfunction rechtsDrehen (tempo: number) {\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, tempo)\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, tempo)\n}\nfunction drehenRechts (dauer: number) {\n    rechtsDrehen(50)\n    basic.pause(dauer)\n    motorenStoppen()\n}\nfunction headlightsShow () {\n    basic.showString(\"HEADLIGHTS\")\n    startZeit = input.runningTime()\n    while (input.runningTime() - startZeit < 30000 && modus == 3) {\n        hindernisPruefen()\n        if (modus == 3) {\n            if (schritt % 4 == 0) {\n                // Vorwärts und Licht an\n                lichtAn()\n                vorwaerts(65)\n                basic.showLeds(`\n                    . . # . .\n                    . # # # .\n                    # # # # #\n                    . # # # .\n                    . . # . .\n                    `)\n                basic.pause(250)\n            } else if (schritt % 4 == 1) {\n                // Linksdrehung\n                lichtAus()\n                linksDrehen(55)\n                basic.pause(250)\n            } else if (schritt % 4 == 2) {\n                // Rechtsdrehung\n                lichtAn()\n                rechtsDrehen(70)\n                basic.pause(250)\n            } else {\n                // Rückwärtsbewegung\n                rueckwaerts(55)\n                basic.showLeds(`\n                    # . # . #\n                    . # # # .\n                    # . # . #\n                    . # # # .\n                    # . # . #\n                    `)\n                basic.pause(250)\n            }\n            motorenStoppen()\n            // Eigene Dance-Melodie\n            ton(440, 120)\n            ton(523, 120)\n            ton(659, 180)\n            schritt += 1\n        }\n    }\n    motorenStoppen()\n    lichtAus()\n    basic.clearScreen()\n}\ninput.onButtonPressed(Button.A, function () {\n    starteModus(1)\n})\nfunction minecraftShow () {\n    basic.showString(\"MINECRAFT\")\n    lichtAn()\n    // Minecraft-Block\n    basic.showLeds(`\n        # # # # #\n        # . . . #\n        # . # . #\n        # . . . #\n        # # # # #\n        `)\n    for (let k = 0; k < 3 && modus == 2; k++) {\n        fahren(55, 600)\n        drehenLinks(350)\n        fahren(55, 600)\n        drehenRechts(350)\n    }\nfor (let l = 0; l < 3 && modus == 2; l++) {\n        basic.showLeds(`\n            . . # . .\n            . # # . .\n            # # # # .\n            . . # . .\n            . . # . .\n        `)\n\n        ton(262, 150)\n\n        basic.showLeds(`\n            . . . . #\n            . . . # #\n            . # # # .\n            . . # . .\n            . . # . .\n        `)\n\n        ton(330, 150)\n    }\n// Creeper-Gesicht\n    basic.showLeds(`\n        # # # # #\n        # . . . #\n        # # . # #\n        # . # . #\n        # . # . #\n        `)\n    for (let m = 0; m < 2 && modus == 2; m++) {\n        drehenLinks(300)\n        fahren(50, 500)\n        drehenRechts(300)\n    }\nmotorenStoppen()\n    lichtAus()\n}\nfunction motorenStoppen () {\n    maqueen.motorStop(maqueen.Motors.M1)\n    maqueen.motorStop(maqueen.Motors.M2)\n}\nfunction lichtAn () {\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOn)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOn)\n}\nfunction hindernisPruefen () {\n    entfernung = maqueen.Ultrasonic()\n    if (entfernung > 0 && entfernung < 15) {\n        motorenStoppen()\n        basic.pause(200)\n        rueckwaerts(40)\n        basic.pause(400)\n        linksDrehen(45)\n        basic.pause(650)\n        motorenStoppen()\n        basic.pause(150)\n    }\n}\nfunction starWarsShow () {\n    basic.showString(\"STAR WARS\")\n    lichtAn()\n    // Imperium-Symbol\n    basic.showLeds(`\n        # . # . #\n        # # # # #\n        . # # # .\n        # . # . #\n        # . # . #\n        `)\n    for (let i = 0; i < 3 && modus == 1; i++) {\n        fahren(55, 700)\n        drehenLinks(250)\n        fahren(55, 500)\n        drehenRechts(250)\n    }\n// Darth-Vader-Symbol\n    basic.showLeds(`\n        . . # . .\n        . # # # .\n        # # # # #\n        . # # # .\n        . # . # .\n        `)\n    // Eigene Melodie\n    ton(330, 250)\n    ton(392, 250)\n    ton(440, 400)\n    ton(392, 250)\n    ton(330, 400)\n    for (let j = 0; j < 2 && modus == 1; j++) {\n        drehenLinks(350)\n        drehenRechts(350)\n        fahren(60, 500)\n    }\nmotorenStoppen()\n    lichtAus()\n}\nfunction vorwaerts (tempo: number) {\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CW, tempo)\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, tempo)\n}\ninput.onButtonPressed(Button.AB, function () {\n    starteModus(3)\n})\ninput.onButtonPressed(Button.B, function () {\n    starteModus(2)\n})\nfunction lichtAus () {\n    maqueen.writeLED(maqueen.LED.LEDLeft, maqueen.LEDswitch.turnOff)\n    maqueen.writeLED(maqueen.LED.LEDRight, maqueen.LEDswitch.turnOff)\n}\nfunction rueckwaerts (tempo: number) {\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, tempo)\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CCW, tempo)\n}\nfunction drehenLinks (dauer: number) {\n    linksDrehen(50)\n    basic.pause(dauer)\n    motorenStoppen()\n}\nfunction starteModus (neuerModus: number) {\n    laufNummer += 1\n    meineNummer = laufNummer\n    modus = neuerModus\n    motorenStoppen()\n    control.inBackground(function () {\n        if (meineNummer == laufNummer) {\n            if (modus == 1) {\n                starWarsShow()\n            } else if (modus == 2) {\n                minecraftShow()\n            } else if (modus == 3) {\n                headlightsShow()\n            }\n        }\n\n        if (meineNummer == laufNummer) {\n            modus = 0\n            motorenStoppen()\n            lichtAus()\n        }\n    })\n}\nfunction linksDrehen (tempo: number) {\n    maqueen.motorRun(maqueen.Motors.M1, maqueen.Dir.CCW, tempo)\n    maqueen.motorRun(maqueen.Motors.M2, maqueen.Dir.CW, tempo)\n}\nfunction ton (frequenz: number, dauer: number) {\n    if (modus != 0) {\n        music.playTone(frequenz, dauer)\n    }\n}\nlet meineNummer = 0\nlet entfernung = 0\nlet schritt = 0\nlet startZeit = 0\nlet start = 0\nlet laufNummer = 0\nlet modus = 0\nmotorenStoppen()\nlichtAus()\nbasic.showString(\"A/B/AB\")\n"]]}]}]},{"timestamp":1794588834643,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1419,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"AvAF,Yp4VW/OCpeKGb74\">entfernung</variable><variable id=\"nok7PvX!5f%n}(KrjX})\">start</variable><variable id=\"l%j1;|*z,HAp2cGedTW@\">modus</variable><variable id=\"l6}_TIePf@r)b2J.WqO*\">startZeit</variable><variable id=\"?ocYMhHgq4nS6S.X8B7s\">schritt</variable><variable id=\"3qcgp`+0@C@VLVlbjV|:\">laufNummer</variable><variable id=\"Jjj@cE9oL]_9I:7dlcRN\">meineNummer</variable></variables><comment x=\"456.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nMAQUEEN – MOTOREN\n=====================================\n</comment><comment x=\"871.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nLICHTER – KORRIGIERTE VERSION\n=====================================\n</comment><comment x=\"1286.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nULTRASCHALLSENSOR\n=====================================\n</comment><comment x=\"1701.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nFAHRBEWEGUNGEN MIT SENSOR\n=====================================\n</comment><comment x=\"2116.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nMUSIK\n=====================================\n</comment><comment x=\"2531.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nTASTE A – STAR WARS SHOW\n=====================================\n</comment><comment x=\"2946.109375\" y=\"2496.5\" w=\"370\" h=\"120\">\n=====================================\nTASTE B – MINECRAFT SHOW\n=================